# Salin file ini menjadi ".env" lalu isi nilai sebenarnya.
# JANGAN pernah commit file ".env" (sudah di-exclude di .gitignore).
# Untuk deploy ke hosting (Back4App dsb), isi semua ini lewat
# dashboard Environment Variables, BUKAN lewat file .env.

# ==========================================
# DATABASE
# ==========================================
# Wajib diisi dengan koneksi PostgreSQL. SQLite tidak didukung.
# Ganti placeholder dengan detail database Anda, jangan commit kredensial.
# Contoh format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Opsional: folder dasar backup, default backend/backups/postgresql.
# UI Admin hanya dapat memilih subfolder relatif di dalam folder dasar ini.
# Retensi UI dapat disetel dari aplikasi; variabel ini menjadi default.
# Aktifkan hanya pada backend native tzserver; default tetap nonaktif.
# POSTGRES_BACKUP_ENABLED=true
# POSTGRES_BACKUP_DIR=
# POSTGRES_BACKUP_RETENTION=14
# Jika utilitas tidak ada di PATH proses backend, isi path executable
# masing-masing untuk komputer/server ini (contoh Windows):
# POSTGRES_PG_DUMP_PATH='C:\Program Files\PostgreSQL\17\bin\pg_dump.exe'
# POSTGRES_PG_RESTORE_PATH='C:\Program Files\PostgreSQL\17\bin\pg_restore.exe'

# ==========================================
# AUTH / JWT
# ==========================================
# WAJIB diisi. Generate dengan salah satu cara berikut lalu
# tempel hasilnya di sini (jangan pakai contoh/placeholder ini
# di environment production):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# CORS
# ==========================================
# Daftar origin frontend yang diizinkan mengakses API ini,
# dipisah koma (TANPA spasi setelah koma, tanpa trailing slash).
# Dev lokal (Vite): boleh dikosongkan, otomatis fallback ke
# http://localhost:5173,http://127.0.0.1:5173 (lihat config.py).
# Production: WAJIB diisi domain asli, contoh:
#   CORS_ORIGINS=https://tka-ai.vercel.app
#
# CATATAN: akses dari laptop/HP lain di WiFi/LAN yang sama (mis.
# http://192.168.1.5:5173) TIDAK perlu ditambahkan di sini — sudah
# otomatis diizinkan lewat CORS_ORIGIN_REGEX di config.py. Baris ini
# hanya untuk domain asli/publik.
CORS_ORIGINS=

# ==========================================
# AKUN ADMIN DEFAULT (BOOTSTRAP OTOMATIS SAAT TABEL USER KOSONG)
# ==========================================
# Dipakai HANYA sekali, saat tabel t_user masih benar-benar kosong
# (mis. deploy pertama kali ke hosting dengan filesystem ephemeral).
# WAJIB diisi sendiri di environment production — kalau dikosongkan,
# fallback ke "admin"/"123456" (TIDAK AMAN untuk production, segera
# login & ganti password kalau terpaksa pakai fallback ini).
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

# ==========================================
# AI PROVIDER — PROVIDER AKTIF (FALLBACK AWAL)
# ==========================================
# "OLLAMA" atau "GEMINI". Ini cuma fallback awal — provider yang
# sebenarnya dipakai runtime disimpan di tabel t_app_setting supaya
# bisa diganti admin dari UI Pengaturan tanpa restart server.
AI_PROVIDER=OLLAMA

# ==========================================
# OLLAMA (GENERATE SOAL DENGAN AI - LOKAL)
# ==========================================
# Ollama dijalankan lokal di laptop guru/admin. Tidak relevan kalau
# AI_PROVIDER=GEMINI atau deploy ke cloud (Ollama tidak bisa diakses
# dari internet kecuali di-tunnel).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ==========================================
# GEMINI (GENERATE SOAL DENGAN AI - CLOUD)
# ==========================================
# Nilai di bawah ini HANYA dipakai sebagai fallback kalau admin
# belum pernah mengisi lewat UI Pengaturan sama sekali (mis. saat
# instalasi awal). API key yang diisi lewat UI disimpan terenkripsi
# di database, bukan di .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opsional: model cadangan kalau model utama kena error 503 "high demand"
# berkali-kali. Kosongkan kalau tidak dipakai.
GEMINI_FALLBACK_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ==========================================
# PORT (HANYA UNTUK TAMPILAN DI HALAMAN PENGATURAN > JARINGAN)
# ==========================================
# Opsional. Cuma dipakai untuk MENAMPILKAN contoh URL yang benar di
# halaman Pengaturan > Jaringan. Kosongkan kalau pakai port default
# (frontend 5173, backend 8000). Mengubah nilai di sini TIDAK
# mengubah port sungguhan yang dipakai uvicorn/Vite.
FRONTEND_PORT=
BACKEND_PORT=
