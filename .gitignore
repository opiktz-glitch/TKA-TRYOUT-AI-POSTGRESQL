# Environment files (JANGAN pernah commit — berisi SECRET_KEY, DATABASE_URL, dll)
# Pola generik "*.env" di bawah ini sengaja dipasang supaya SEMUA
# variasi nama file .env (docker.env, dockeronline.env, staging.env,
# dst — bukan cuma nama yang sudah kepikiran sekarang) otomatis ikut
# ter-exclude, tanpa perlu nambah baris baru tiap kali bikin file
# .env dengan nama baru.
*.env
.env.*
!.env.example
!*/.env.example

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# Database
*.db
*.db-shm
*.db-wal
backend/backups/

# Node / frontend build
node_modules/
frontend/dist/
frontend/build/

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Docker image export (besar, tidak perlu ikut repo)
*.tar
